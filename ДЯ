<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudySync - Расписание занятий</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
            padding: 30px;
        }

        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 28px;
        }

        .subtitle {
            color: #666;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 2px solid #667eea;
        }

        .filters {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 25px;
            display: flex;
            gap: 20px;
            align-items: center;
            flex-wrap: wrap;
        }

        .filters label {
            font-weight: 600;
            color: #333;
        }

        .filters select {
            padding: 8px 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            background: white;
        }

        .lesson-count {
            background: #667eea;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }

        .schedule-list {
            margin-bottom: 30px;
            max-height: 400px;
            overflow-y: auto;
        }

        .lesson-card {
            background: #f8f9fa;
            border-left: 4px solid #667eea;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: transform 0.2s;
        }

        .lesson-card:hover {
            transform: translateX(5px);
            background: #e9ecef;
        }

        .lesson-info {
            flex: 1;
        }

        .lesson-name {
            font-weight: 700;
            color: #333;
            font-size: 16px;
        }

        .lesson-details {
            color: #666;
            font-size: 14px;
            margin-top: 5px;
        }

        .delete-btn {
            background: #dc3545;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.3s;
        }

        .delete-btn:hover {
            background: #c82333;
        }

        .add-form {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
        }

        .add-form h3 {
            margin-bottom: 15px;
            color: #333;
        }

        .form-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }

        .form-group input, .form-group select {
            flex: 1;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
        }

        .add-btn {
            background: #28a745;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: background 0.3s;
            width: 100%;
        }

        .add-btn:hover {
            background: #218838;
        }

        .error-message {
            background: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 15px;
            display: none;
        }

        @media (max-width: 600px) {
            .container {
                padding: 15px;
            }
            .lesson-card {
                flex-direction: column;
                text-align: center;
                gap: 10px;
            }
            .delete-btn {
                width: 100%;
            }
            .filters {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>StudySync</h1>
        <div class="subtitle">Электронное расписание занятий</div>

        <div class="filters">
            <label>Фильтр по дню недели:</label>
            <select id="dayFilter">
                <option value="all">Все дни</option>
                <option value="Понедельник">Понедельник</option>
                <option value="Вторник">Вторник</option>
                <option value="Среда">Среда</option>
                <option value="Четверг">Четверг</option>
                <option value="Пятница">Пятница</option>
            </select>
            <div class="lesson-count" id="lessonCount">Пар: 0</div>
        </div>

        <div class="error-message" id="errorMessage"></div>

        <div class="schedule-list" id="scheduleList"></div>

        <div class="add-form">
            <h3>Добавить новое занятие</h3>
            <div class="form-group">
                <input type="text" id="lessonName" placeholder="Название предмета">
                <input type="text" id="lessonTime" placeholder="Время (например, 10:00)">
                <select id="lessonDay">
                    <option value="Понедельник">Понедельник</option>
                    <option value="Вторник">Вторник</option>
                    <option value="Среда">Среда</option>
                    <option value="Четверг">Четверг</option>
                    <option value="Пятница">Пятница</option>
                </select>
            </div>
            <button class="add-btn" onclick="addLesson()">Добавить занятие</button>
        </div>
    </div>

    <script>
        let lessons = [
            { name: "Математика", time: "09:00", day: "Понедельник" },
            { name: "Физика", time: "11:00", day: "Понедельник" },
            { name: "Программирование", time: "10:00", day: "Вторник" },
            { name: "Английский язык", time: "13:00", day: "Среда" },
            { name: "Базы данных", time: "09:00", day: "Четверг" },
            { name: "Веб-разработка", time: "14:00", day: "Пятница" }
        ];

        function renderSchedule() {
            const filter = document.getElementById("dayFilter").value;
            let filteredLessons = lessons;
            
            if (filter !== "all") {
                filteredLessons = lessons.filter(lesson => lesson.day === filter);
            }
            
            const container = document.getElementById("scheduleList");
            container.innerHTML = "";
            
            if (filteredLessons.length === 0) {
                container.innerHTML = '<div style="text-align: center; padding: 40px; color: #999;">Нет занятий на выбранный день</div>';
            } else {
                filteredLessons.forEach((lesson, index) => {
                    const originalIndex = lessons.findIndex(l => l.name === lesson.name && l.time === lesson.time && l.day === lesson.day);
                    const div = document.createElement("div");
                    div.className = "lesson-card";
                    div.innerHTML = `
                        <div class="lesson-info">
                            <div class="lesson-name">${lesson.name}</div>
                            <div class="lesson-details">${lesson.day} | ${lesson.time}</div>
                        </div>
                        <button class="delete-btn" onclick="deleteLesson(${originalIndex})">Удалить</button>
                    `;
                    container.appendChild(div);
                });
            }
            
            document.getElementById("lessonCount").innerHTML = `Пар: ${filteredLessons.length}`;
        }
        
        function addLesson() {
            const name = document.getElementById("lessonName").value.trim();
            const time = document.getElementById("lessonTime").value.trim();
            const day = document.getElementById("lessonDay").value;
            const errorDiv = document.getElementById("errorMessage");
            
            if (name === "") {
                errorDiv.style.display = "block";
                errorDiv.innerHTML = "Ошибка: введите название предмета";
                return;
            }
            
            if (time === "") {
                errorDiv.style.display = "block";
                errorDiv.innerHTML = "Ошибка: введите время занятия";
                return;
            }
            
            const timeRegex = /^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/;
            if (!timeRegex.test(time)) {
                errorDiv.style.display = "block";
                errorDiv.innerHTML = "Ошибка: введите время в формате ЧЧ:ММ (например, 09:00)";
                return;
            }
            
            errorDiv.style.display = "none";
            
            lessons.push({ name, time, day });
            
            document.getElementById("lessonName").value = "";
            document.getElementById("lessonTime").value = "";
            
            renderSchedule();
        }
        
        function deleteLesson(index) {
            if (index !== -1) {
                lessons.splice(index, 1);
                renderSchedule();
                
                const errorDiv = document.getElementById("errorMessage");
                errorDiv.style.display = "block";
                errorDiv.style.background = "#d4edda";
                errorDiv.style.color = "#155724";
                errorDiv.innerHTML = "Занятие успешно удалено";
                setTimeout(() => {
                    errorDiv.style.display = "none";
                    errorDiv.style.background = "#f8d7da";
                    errorDiv.style.color = "#721c24";
                }, 2000);
            }
        }
        
        document.getElementById("dayFilter").addEventListener("change", renderSchedule);
        
        renderSchedule();
    </script>
</body>
</html>
